# Copy to .env (gitignored) and fill in. Never commit or print the real values.

# Storyblok space (EU region). Space ID: Settings > Space.
STORYBLOK_SPACE_ID=
# Personal access token (My account > Personal access tokens). Used by storyblok:components / storyblok:push only.
STORYBLOK_MANAGEMENT_TOKEN=
# Content Delivery token: preview token for draft content (dev preview, roundtrip), public token for production builds.
STORYBLOK_TOKEN=

# local (default) = src/content only; storyblok = Storyblok first, local JSON fills the gaps.
# CONTENT_SOURCE=storyblok
# draft | published (default)
# STORYBLOK_VERSION=published
