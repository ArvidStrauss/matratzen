---
interface Props {
  eyebrow?: string;
  heading?: string;
  href?: string;
  level?: 'h1' | 'h2' | 'h3';
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, heading, href, level = 'h2', align = 'left', class: className } = Astro.props;
const Tag = level;
---

{
  (eyebrow || heading) && (
    <header class:list={[align === 'center' && 'mx-auto max-w-3xl text-center', 'mb-8', className]}>
      {eyebrow && (
        <p class="mb-3 text-xs font-semibold tracking-[0.18em] text-accent-600 uppercase [.tone-dark_&]:text-accent-400">{eyebrow}</p>
      )}
      {heading && (
        <Tag class="text-2xl leading-tight font-bold tracking-tight text-balance text-brand-800 sm:text-3xl [.tone-dark_&]:text-white">
          {href ? (
            <a href={href} class="hover:text-brand-600">
              {heading}
            </a>
          ) : (
            heading
          )}
        </Tag>
      )}
    </header>
  )
}
