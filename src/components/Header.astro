---
import { getCollection, getEntry } from 'astro:content';
import Img from './Img.astro';
import { telHref } from '../lib/format';

const settings = (await getEntry('settings', 'global'))!.data;
const branches = (await getCollection('branches')).sort((a, b) => a.data.order - b.data.order);
const headerBranches = branches.filter((b) => b.id !== 'kiel');
const current = Astro.url.pathname;
const isActive = (href?: string) => !!href && href !== '/' && current.startsWith(href);
---

<div class="bg-brand-900 text-sm text-brand-100">
  <div class="container-page flex h-10 items-center justify-between gap-4">
    <ul class="hidden items-center gap-6 sm:flex">
      {
        headerBranches.map((b) => (
          <li>
            <a href={telHref(b.data.phone)} class="hover:text-white">
              <span class="text-brand-300">{b.data.name}</span> {b.data.phone}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={settings.appointmentCta.href} class="ml-auto font-semibold text-accent-400 hover:text-white">
      {settings.appointmentCta.label} →
    </a>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-sand-200 bg-white/90 backdrop-blur">
  <div class="container-page relative flex h-20 items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label={settings.siteName}>
      <Img src={settings.logo.src} alt={settings.logo.alt} class="h-12 w-auto" loading="eager" />
    </a>

    <nav aria-label="Hauptmenü" class="hidden self-stretch lg:block">
      <ul class="flex h-full gap-0.5 whitespace-nowrap">
        {
          settings.navigation.map((item, index) => {
            const isMega = item.children?.some((c) => c.children?.length);
            const alignRight = index >= settings.navigation.length - 3;
            // Items span the full header height, so the pointer never leaves the item between button and flyout.
            return (
              <li class:list={['group flex items-center', !isMega && 'relative']}>
                {item.children ? (
                  <button
                    type="button"
                    class:list={[
                      'flex items-center gap-1 rounded-full px-2.5 py-2 text-sm font-medium text-ink/80 hover:bg-brand-50 hover:text-brand-700 group-focus-within:bg-brand-50',
                      item.children.some((c) => isActive(c.href)) && 'text-brand-700',
                    ]}
                    aria-haspopup="true"
                  >
                    {item.label}
                    <svg class="size-3.5 opacity-60" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" />
                    </svg>
                  </button>
                ) : (
                  <a href={item.href} class="block rounded-full px-2.5 py-2 text-sm font-medium text-ink/80 hover:bg-brand-50 hover:text-brand-700">
                    {item.label}
                  </a>
                )}
                {item.children && (
                  <div
                    class:list={[
                      // Opens at once, closes after 150 ms, so a diagonal move towards the flyout does not close it.
                      'invisible absolute top-full pt-2 opacity-0 transition delay-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 group-hover:delay-0',
                      isMega ? 'inset-x-5 sm:inset-x-8' : alignRight ? 'right-0 min-w-72' : 'left-0 min-w-72',
                    ]}
                  >
                    <div class="rounded-card border border-sand-200 bg-white p-6 shadow-card">
                      {isMega ? (
                        <div class="grid grid-cols-3 gap-8">
                          {item.children.map((col) => (
                            <div>
                              <a href={col.href} class="block font-semibold text-brand-800 hover:text-brand-600">
                                {col.label}
                                {col.note && <span class="ml-2 rounded-full bg-accent-100 px-2 py-0.5 text-xs font-semibold text-accent-600">{col.note}</span>}
                              </a>
                              {col.children && (
                                <ul class="mt-3 space-y-1.5 border-t border-sand-200 pt-3">
                                  {col.children.map((link) => (
                                    <li>
                                      <a href={link.href} class="text-sm text-ink/75 hover:text-brand-700">
                                        {link.label}
                                        {link.note && <span class="ml-1.5 text-xs font-semibold text-accent-600">{link.note}</span>}
                                      </a>
                                    </li>
                                  ))}
                                </ul>
                              )}
                            </div>
                          ))}
                        </div>
                      ) : (
                        <ul class="space-y-2">
                          {item.children.map((link) => (
                            <li>
                              <a href={link.href} class="text-sm font-medium text-ink/80 hover:text-brand-700">
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <details class="group/mobile lg:hidden">
      <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-sand-200 [&::-webkit-details-marker]:hidden" aria-label="Menü">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <div class="absolute inset-x-0 top-full max-h-[80vh] overflow-y-auto border-b border-sand-200 bg-white p-5 shadow-card">
        <ul class="divide-y divide-sand-200">
          {
            settings.navigation.map((item) => (
              <li class="py-2">
                {item.children ? (
                  <details>
                    <summary class="cursor-pointer py-2 font-semibold text-brand-800">{item.label}</summary>
                    <ul class="space-y-2 pb-2 pl-3">
                      {item.children.map((col) => (
                        <li>
                          <a href={col.href} class="font-medium text-ink/85">
                            {col.label}
                          </a>
                          {col.children && (
                            <ul class="mt-1 space-y-1 pl-3">
                              {col.children.map((link) => (
                                <li>
                                  <a href={link.href} class="text-sm text-ink/70">
                                    {link.label}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </li>
                      ))}
                    </ul>
                  </details>
                ) : (
                  <a href={item.href} class="block py-2 font-semibold text-brand-800">
                    {item.label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </details>
  </div>
</header>
