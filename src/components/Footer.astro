---
import { getEntry } from 'astro:content';
import Img from './Img.astro';

const settings = (await getEntry('settings', 'global'))!.data;
const { footer } = settings;
---

<footer class="bg-brand-950 text-brand-100">
  <div class="container-page grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <div class="inline-block rounded-xl bg-white p-3">
        <Img src={settings.logo.src} alt={settings.logo.alt} class="h-12 w-auto" />
      </div>
      <p class="mt-6 font-semibold text-white">{footer.heading}</p>
      <p class="mt-2 max-w-sm text-sm leading-relaxed">{footer.address}</p>
      <p class="mt-4 space-x-4 text-sm">
        <a href={footer.phone.href} class="font-semibold text-white hover:text-accent-400">{footer.phone.label}</a>
        <a href={footer.email.href} class="hover:text-white">{footer.email.label}</a>
      </p>
    </div>
    {
      footer.columns.map((col) => (
        <div>
          <p class="text-xs font-semibold tracking-[0.18em] text-brand-300 uppercase">{col.heading}</p>
          <ul class="mt-4 space-y-2 text-sm">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white">
                  {link.label}
                  {link.note && <span class="block text-brand-300">{link.note}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-3 py-6 text-xs text-brand-300 sm:flex-row sm:items-center sm:justify-between">
      <p>{footer.copyright}</p>
      <ul class="flex gap-5">
        {
          footer.legal.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
