---
import type { Block } from '../content.config';
import PromoTiles from './blocks/PromoTiles.astro';
import Hero from './blocks/Hero.astro';
import CategoryPrices from './blocks/CategoryPrices.astro';
import MediaText from './blocks/MediaText.astro';
import ProductGrid from './blocks/ProductGrid.astro';
import ProductVariants from './blocks/ProductVariants.astro';
import CardGrid from './blocks/CardGrid.astro';
import Testimonials from './blocks/Testimonials.astro';
import AppointmentCta from './blocks/AppointmentCta.astro';
import BranchList from './blocks/BranchList.astro';
import BranchHero from './blocks/BranchHero.astro';
import Gallery from './blocks/Gallery.astro';
import LinkList from './blocks/LinkList.astro';
import Content from './blocks/Content.astro';
import RichText from './blocks/RichText.astro';
import Table from './blocks/Table.astro';
import Accordion from './blocks/Accordion.astro';
import ProductHeader from './blocks/ProductHeader.astro';
import Tabs from './blocks/Tabs.astro';
import Snippet from './blocks/Snippet.astro';

interface Props {
  blocks: Block[];
}

// One Astro component per Storyblok block name.
const registry = {
  promoTiles: PromoTiles,
  hero: Hero,
  categoryPrices: CategoryPrices,
  mediaText: MediaText,
  productGrid: ProductGrid,
  productVariants: ProductVariants,
  cardGrid: CardGrid,
  testimonials: Testimonials,
  appointmentCta: AppointmentCta,
  branchList: BranchList,
  branchHero: BranchHero,
  gallery: Gallery,
  linkList: LinkList,
  content: Content,
  richText: RichText,
  table: Table,
  accordion: Accordion,
  productHeader: ProductHeader,
  tabs: Tabs,
  snippet: Snippet,
} satisfies Record<Block['component'], unknown>;

const { blocks } = Astro.props;
---

{
  blocks.map((block) => {
    const Component = registry[block.component] as any;
    return <Component {...block} />;
  })
}
