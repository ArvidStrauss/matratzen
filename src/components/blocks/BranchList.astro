---
import { getEntries } from 'astro:content';
import type { Block } from '../../content.config';
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Img from '../Img.astro';
import { telHref } from '../../lib/format';

type Props = Extract<Block, { component: 'branchList' }>;
const { heading, linkLabel } = Astro.props;
const branches = await getEntries(Astro.props.branches);
---

<Section tone="sand">
  <SectionHeading heading={heading} />
  <ul class="grid gap-6 md:grid-cols-2">
    {
      branches.map(({ data: b }) => (
        <li class="grid overflow-hidden rounded-card bg-white shadow-card sm:grid-cols-[2fr_3fr]">
          {b.image && <Img src={b.image.src} alt={b.image.alt} class="h-48 w-full object-cover sm:h-full" />}
          <div class="p-6">
            <h3 class="text-xl font-bold text-brand-800">{b.city ?? b.name}</h3>
            <address class="mt-3 text-sm leading-relaxed text-ink/80 not-italic">
              {b.street},<br />
              {b.zip} {b.city},<br />
              {b.region}.
            </address>
            <p class="mt-3 text-sm">
              Tel:{' '}
              <a href={telHref(b.phone)} class="font-semibold text-brand-700 hover:text-brand-600">
                {b.phone}
              </a>
            </p>
            <a href={b.href} class="btn-ghost mt-5">
              {linkLabel}
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
