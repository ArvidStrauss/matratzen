---
import type { Block } from '../../content.config';
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Img from '../Img.astro';
import Md from '../Md.astro';
import { formatEuro, isExternal } from '../../lib/format';

type Props = Extract<Block, { component: 'cardGrid' }>;
const { eyebrow, heading, headingHref, intro, columns, imageFit, cards, ctas, tone } = Astro.props;
const cols = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-2 lg:grid-cols-3', 4: 'sm:grid-cols-2 lg:grid-cols-4' }[columns];
const mixed = cards.some((c) => c.image) && cards.some((c) => !c.image);
---

<Section tone={tone}>
  <SectionHeading eyebrow={eyebrow} heading={heading} href={headingHref} />
  {
    intro.length > 0 && (
      <div class="-mt-3 mb-8 max-w-3xl space-y-2 leading-relaxed text-ink/80">
        {intro.map((t) => (
          <Md text={t} />
        ))}
      </div>
    )
  }
  <ul class:list={['grid gap-6', cols]}>
    {
      cards.map((card) => {
        const external = card.href ? isExternal(card.href) : false;
        return (
          <li class:list={['flex flex-col overflow-hidden rounded-card border border-sand-200 transition hover:shadow-card', mixed && !card.image ? 'bg-brand-50' : 'bg-white']}>
            {card.image && (
              <a
                href={card.href}
                class:list={['relative block', imageFit === 'contain' ? 'bg-sand-50 p-5' : '']}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener' : undefined}
              >
                <Img src={card.image.src} alt={card.image.alt} class:list={['w-full', imageFit === 'cover' ? 'aspect-[16/10] object-cover' : 'h-40 object-contain']} />
                {card.isVideo && (
                  <span class="absolute inset-0 flex items-center justify-center">
                    <span class="flex size-14 items-center justify-center rounded-full bg-white/90 text-brand-700 shadow-card">
                      <svg class="ml-1 size-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14Z" />
                      </svg>
                    </span>
                  </span>
                )}
              </a>
            )}
            <div class:list={['flex flex-1 flex-col p-6', mixed && !card.image && 'justify-center sm:p-10']}>
              {card.eyebrow && <p class="text-xs font-semibold tracking-[0.18em] text-accent-600 uppercase">{card.eyebrow}</p>}
              {card.title && (
                <Fragment>
                  {(() => {
                    const Tag = card.titleTag;
                    const classes = ['mt-1 leading-snug font-bold text-brand-800', mixed && !card.image ? 'text-2xl sm:text-3xl' : 'text-lg'];
                    return (
                      <Tag class:list={classes}>
                        {card.href && !card.linkLabel ? (
                          <a href={card.href} class="hover:text-brand-600" target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                            {card.title}
                          </a>
                        ) : (
                          card.title
                        )}
                      </Tag>
                    );
                  })()}
                </Fragment>
              )}
              {card.subtitle && <Md text={card.subtitle} class="mt-1 text-sm text-ink/75" />}
              {card.text.length > 0 && (
                <div class="mt-2 space-y-2 text-sm leading-relaxed text-ink/75">
                  {card.text.map((t) => (
                    <Md text={t} />
                  ))}
                </div>
              )}
              {card.bullets.length > 0 && (
                <ul class="mt-3 space-y-2 text-sm text-ink/80">
                  {card.bullets.map((b) => (
                    <li class="flex gap-2.5">
                      <svg class="mt-0.5 size-4 shrink-0 text-brand-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.58l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
                      </svg>
                      <Md text={b} as="span" />
                    </li>
                  ))}
                </ul>
              )}
              {card.price !== undefined && (
                <p class="mt-3 flex flex-wrap items-baseline gap-x-2">
                  {card.priceRegular !== undefined && <s class="text-sm text-muted">{formatEuro(card.priceRegular)}</s>}
                  {card.pricePrefix && <span class="text-sm text-muted">{card.pricePrefix}</span>}
                  <span class="text-xl font-bold text-brand-700">{formatEuro(card.price)}</span>
                </p>
              )}
              {card.note && <p class="mt-1 text-xs text-muted">{card.note}</p>}
              {card.cta && (
                <a href={card.cta.href} class="btn-primary mt-4 self-start">
                  {card.cta.label}
                </a>
              )}
              {card.linkLabel && card.href && (
                <a href={card.href} class:list={['inline-flex pt-4 text-sm font-semibold text-brand-700 hover:text-brand-600', !(mixed && !card.image) && 'mt-auto']}>
                  {card.linkLabel}
                </a>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>
  {
    ctas.length > 0 && (
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        {ctas.map((cta) => (
          <a href={cta.href} class="btn-primary">
            {cta.label}
          </a>
        ))}
      </div>
    )
  }
</Section>
