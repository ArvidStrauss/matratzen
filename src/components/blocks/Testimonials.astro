---
import type { Block } from '../../content.config';
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Md from '../Md.astro';

type Props = Extract<Block, { component: 'testimonials' }>;
const { heading, intro, items, cta } = Astro.props;
---

<Section>
  <SectionHeading heading={heading} />
  {intro && <Md text={intro} class="-mt-4 mb-8 text-sm text-muted" />}
  <ul class:list={['grid gap-6 @2xl:grid-cols-2', items.length === 3 ? '@4xl:grid-cols-3' : '@6xl:grid-cols-4']}>
    {
      items.map((item) => (
        <li class="flex flex-col rounded-card bg-sand-100 p-6">
          <svg class="size-8 text-brand-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M9.5 6C6.46 6 4 8.46 4 11.5V18h6v-6H6.5A3 3 0 0 1 9.5 9V6Zm10 0C16.46 6 14 8.46 14 11.5V18h6v-6h-3.5a3 3 0 0 1 3-3V6Z" />
          </svg>
          {item.product && <p class="mt-3 text-xs font-semibold tracking-wide text-brand-700 uppercase">{item.product}</p>}
          {item.rating && (
            <p class="mt-3 text-accent-500" role="img" aria-label={`${item.rating} von 5 Sternen`}>
              {'★'.repeat(item.rating)}
            </p>
          )}
          <blockquote class="mt-3 space-y-3 text-sm leading-relaxed text-ink/80">
            {item.summary && item.text.length ? (
              // Collapsed like the live site (<details>, "Mehr Info…" is its UI label, not content).
              <details class="group space-y-3">
                <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <Md text={item.summary} as="span" class="font-semibold text-ink" />{' '}
                  <span class="prose-link text-brand-700 underline group-open:hidden">Mehr Info…</span>
                </summary>
                {item.text.map((t) => (
                  <p>{t}</p>
                ))}
              </details>
            ) : (
              <>
                {item.summary && <Md text={item.summary} class="font-semibold text-ink" />}
                {item.text.map((t) => (
                  <p>{t}</p>
                ))}
              </>
            )}
          </blockquote>
          <p class="mt-auto pt-5 text-sm font-semibold text-ink">
            {item.author}
            {item.meta && <span class="font-normal text-muted"> | {item.meta}</span>}
          </p>
        </li>
      ))
    }
  </ul>
  {
    cta && (
      <div class="mt-8">
        <a href={cta.href} class="btn-ghost">
          {cta.label}
        </a>
      </div>
    )
  }
</Section>
