---
import { getEntry } from 'astro:content';
import type { Block } from '../../content.config';
import Img from '../Img.astro';
import { telHref } from '../../lib/format';

type Props = Extract<Block, { component: 'branchHero' }>;
const { headingLines, contactHeading, hoursHeading, cta, ctaNote, seal, mapsLabel } = Astro.props;
const b = (await getEntry(Astro.props.branch))!.data;
---

<section class="relative overflow-hidden bg-brand-900 text-white">
  {b.image && <Img src={b.image.src} alt="" class="absolute inset-0 size-full object-cover opacity-30" loading="eager" />}
  <div class="absolute inset-0 bg-gradient-to-r from-brand-950 via-brand-950/85 to-brand-950/40"></div>
  <div class="container-page relative grid gap-10 py-16 sm:py-24 lg:grid-cols-[1.2fr_1fr] lg:items-center">
    <div>
      <p class="mb-4 text-xs font-semibold tracking-[0.18em] text-accent-400 uppercase">{b.name}</p>
      <h1 class="text-4xl leading-[1.05] font-extrabold tracking-tight text-balance sm:text-6xl">
        {headingLines.map((line, i) => <span class:list={['block', i > 0 && 'text-brand-300']}>{line}</span>)}
      </h1>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={cta.href} class="btn-accent">{cta.label}</a>
        {
          b.mapsHref && mapsLabel && (
            <a href={b.mapsHref} target="_blank" rel="noopener" class="btn border border-white/30 text-white hover:bg-white/10">
              {mapsLabel}
            </a>
          )
        }
      </div>
      {ctaNote && <p class="mt-4 max-w-md text-sm text-brand-100">{ctaNote}</p>}
    </div>

    <div class="rounded-card bg-white p-6 text-ink shadow-card sm:p-8">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold text-brand-800">{contactHeading}</h2>
          {b.company && <p class="text-sm text-muted">{b.company}</p>}
        </div>
        {seal && <Img src={seal.src} alt={seal.alt} class="w-16 shrink-0" />}
      </div>
      <address class="mt-4 space-y-1 text-sm not-italic">
        <p>{b.street}, {b.zip} {b.city}</p>
        <p>Fon: <a href={telHref(b.phone)} class="font-semibold text-brand-700 hover:text-brand-600">{b.phone}</a></p>
        {b.fax && <p>Fax: {b.fax}</p>}
        {b.email && <p>Email : <a href={`mailto:${b.email}`} class="text-brand-700 hover:text-brand-600">{b.email}</a></p>}
      </address>
      {
        b.hours && (
          <div class="mt-5 border-t border-sand-200 pt-5">
            <p class="text-sm font-semibold">{hoursHeading}</p>
            <ul class="mt-2 space-y-1 text-sm text-ink/80">
              {b.hours.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>
