---
import type { Block } from '../../content.config';
import Img from '../Img.astro';
import Md from '../Md.astro';

type Props = Extract<Block, { component: 'hero' }>;
const { eyebrow, headingLines, subheading, seal, introTitle, bullets, ctas, rating, aside } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white">
  <div class:list={['container-page grid gap-12 py-14 sm:py-20', aside && 'lg:grid-cols-[1.1fr_1fr] lg:items-start']}>
    <div>
      <div class="flex items-start gap-6">
        <div class="flex-1">
          {eyebrow && <p class="mb-4 text-xs font-semibold tracking-[0.18em] text-accent-600 uppercase">{eyebrow}</p>}
          <h1 class="text-4xl leading-[1.05] font-extrabold tracking-tight text-balance text-brand-800 sm:text-5xl lg:text-[2.75rem] xl:text-5xl">
            {headingLines.map((line, i) => <span class:list={['block', i > 0 && 'text-brand-600']}>{line}</span>)}
          </h1>
        </div>
        {seal && <Img src={seal.src} alt={seal.alt} class="hidden w-24 shrink-0 rounded-full shadow-card sm:block xl:w-28" loading="eager" />}
      </div>

      {subheading && <Md text={subheading} class="mt-6 max-w-xl text-lg leading-relaxed text-ink/80" />}

      {
        introTitle && (
          <div class="mt-8">
            <p class="font-semibold">{introTitle}</p>
            <ul class="mt-4 space-y-3">
              {bullets.map((b) => (
                <li class="flex gap-3">
                  <svg class="mt-0.5 size-5 shrink-0 text-brand-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.58l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
                  </svg>
                  <Md text={b} as="span" />
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        ctas.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-3">
            {ctas.map((cta, i) => (
              <a href={cta.href} class={i === 0 ? 'btn-primary' : 'btn-ghost'}>
                {cta.label}
              </a>
            ))}
          </div>
        )
      }

      {
        rating && (
          <div class="mt-10 flex flex-col gap-5 rounded-card border border-sand-200 bg-white p-6 shadow-card sm:flex-row sm:items-center">
            <div class="sm:w-48">
              <p class="font-semibold text-balance">{rating.title}</p>
              <a href={rating.cta.href} class="mt-3 inline-block text-sm font-semibold text-brand-700 hover:text-brand-600">
                {rating.cta.label}
              </a>
            </div>
            <a href={rating.cta.href} class="flex-1">
              <Img src={rating.image.src} alt={rating.image.alt} class="h-auto w-full max-w-xs" />
            </a>
          </div>
        )
      }
    </div>

    {
      aside && (
        <aside class="overflow-hidden rounded-card bg-brand-900 text-brand-50 shadow-card">
          <p class="px-6 pt-6 text-sm font-semibold tracking-wide text-white">{aside.title}</p>
          <div class="p-6">
            <video class="aspect-video w-full rounded-xl bg-black object-cover" controls preload="none" poster={aside.poster} src={aside.video}>
              <a href={aside.video}>{aside.video}</a>
            </video>
            <p class="mt-3 text-xs text-brand-200">{aside.caption}</p>
            <div class="tone-dark mt-5 space-y-3 text-sm leading-relaxed">
              {aside.text.map((t) => (
                <Md text={t} />
              ))}
            </div>
            <a href={aside.cta.href} class="btn mt-6 bg-white text-brand-800 hover:bg-brand-100">
              {aside.cta.label}
            </a>
          </div>
        </aside>
      )
    }
  </div>
</section>
