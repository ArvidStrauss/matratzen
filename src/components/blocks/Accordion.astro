---
import type { Block } from '../../content.config';
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import { inlineMd } from '../../lib/md';
import Md from '../Md.astro';

type Props = Extract<Block, { component: 'accordion' }>;
const { heading, items } = Astro.props;
---

<Section class="!py-6 sm:!py-10">
  <div class="max-w-4xl">
    <SectionHeading heading={heading} class="!mb-5" />
    <div class="divide-y divide-sand-200 rounded-card border border-sand-200 bg-white">
      {
        items.map((item) => (
          <details class="group p-5" open={item.open}>
            <summary class="cursor-pointer list-none">
              <h4 class="prose-link font-semibold text-brand-800" set:html={inlineMd(item.title)} />
            </summary>
            <div class="mt-3 space-y-3 leading-relaxed text-ink/80">
              {item.body.map((t) => (
                <Md text={t} />
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</Section>
