---
import type { Block } from '../../content.config';
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Img from '../Img.astro';

type Props = Extract<Block, { component: 'gallery' }>;
const { heading, images } = Astro.props;
---

<Section>
  <SectionHeading heading={heading} />
  <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
    {
      images.map((img) => (
        <li>
          <a href={img.src} target="_blank" rel="noopener" class="group block h-full overflow-hidden rounded-2xl">
            <Img src={img.src} alt={img.alt} class="aspect-[3/2] size-full object-cover transition duration-500 group-hover:scale-105" />
          </a>
        </li>
      ))
    }
  </ul>
</Section>
