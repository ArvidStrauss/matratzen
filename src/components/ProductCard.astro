---
import type { CollectionEntry } from 'astro:content';
import Img from './Img.astro';
import Price from './Price.astro';

interface Props {
  product: CollectionEntry<'products'>['data'];
  cta?: { label: string; href: string };
}

const { product, cta } = Astro.props;
---

<article class="group flex h-full flex-col rounded-card border border-sand-200 bg-white p-5 transition hover:-translate-y-1 hover:shadow-card">
  <a href={product.href} class="relative block">
    {product.badge && <span class="absolute top-0 left-0 z-10 rounded-full bg-accent-500 px-3 py-1 text-xs font-bold text-white">{product.badge}</span>}
    <div class="flex aspect-[4/3] items-center justify-center rounded-xl bg-sand-50 p-4">
      <Img src={product.image.src} alt={product.image.alt} class="max-h-full w-auto object-contain transition duration-500 group-hover:scale-105" />
    </div>
  </a>
  <h3 class="mt-5 leading-snug font-bold text-brand-800">
    <a href={product.href} class="hover:text-brand-600">{product.name}</a>
  </h3>
  {product.subtitle && <p class="mt-1 text-xs text-muted">{product.subtitle}</p>}
  {product.description && <p class="mt-2 text-sm leading-relaxed text-ink/75">{product.description}</p>}
  <div class="mt-auto pt-5">
    <Price from={product.priceFrom} regular={product.priceRegular} />
    {product.size && <p class="mt-1 text-xs text-muted">Größe: {product.size}</p>}
    {
      cta && (
        <a href={cta.href} class="btn-ghost mt-4 w-full">
          {cta.label}
        </a>
      )
    }
  </div>
</article>
