---
// Accordion menu (mobile drawer, or the full menu in variant C). Structure only; classes via `ui`.
import type { NavItem } from '../../content.config';

interface Props {
  items: NavItem[];
  ui: { item: string; top: string; col: string; link: string; note: string };
}

const { items, ui } = Astro.props;
---

<ul class={ui.item}>
  {
    items.map((item) => (
      <li>
        {item.children ? (
          <details class="group/acc">
            <summary class:list={['flex cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden', ui.top]}>
              {item.label}
              <svg class="size-4 opacity-60 transition group-open/acc:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" />
              </svg>
            </summary>
            <ul class="space-y-3 pb-4 pl-1">
              {item.href && (
                <li>
                  <a href={item.href} class={ui.col}>
                    {item.label}
                  </a>
                </li>
              )}
              {item.children.map((col) => (
                <li>
                  <a href={col.href} class={ui.col}>
                    {col.label}
                    {col.note && <span class={ui.note}>{col.note}</span>}
                  </a>
                  {col.children && (
                    <ul class="mt-2 space-y-1.5 pl-3">
                      {col.children.map((link) => (
                        <li>
                          <a href={link.href} class={ui.link}>
                            {link.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </details>
        ) : (
          <a href={item.href} class:list={['block', ui.top]}>
            {item.label}
          </a>
        )}
      </li>
    ))
  }
</ul>
