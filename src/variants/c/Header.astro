---
import type { Branch, Settings } from '../shared';
import Img from '../../components/Img.astro';
import AccordionNav from '../nav/AccordionNav.astro';
import { telHref } from '../../lib/format';
import { icons } from '../icons';

interface Props {
  settings: Settings;
  branches: Branch[];
}

const { settings, branches } = Astro.props;
const headerBranches = branches.filter((b) => b.id !== 'kiel');
---

<header class="sticky top-0 z-40 border-b border-line bg-white/85 backdrop-blur-md">
  <div class="wrap grid h-18 grid-cols-[1fr_auto_1fr] items-center gap-4">
    <button type="button" popovertarget="menu-c" class="flex items-center gap-2.5 justify-self-start rounded-full py-2 pr-3 text-sm font-semibold" aria-label="Menü">
      <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3.75 9h16.5m-16.5 6.75h16.5"></path></svg>
      <span class="hidden sm:inline">Menü</span>
    </button>
    <a href="/" aria-label={settings.siteName}>
      <Img src={settings.logo.src} alt={settings.logo.alt} class="h-11 w-auto" loading="eager" />
    </a>
    <div class="flex items-center gap-2 justify-self-end">
      <a href={settings.footer.phone.href} class="hidden items-center gap-2 rounded-full px-3 py-2 text-sm font-semibold md:flex">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={icons.phone}></path></svg>
        {settings.footer.phone.label}
      </a>
      <a href={settings.appointmentCta.href} class="btn-black hidden lg:inline-flex">{settings.appointmentCta.label}</a>
    </div>
  </div>
</header>

<div id="menu-c" popover class="fixed inset-y-0 left-0 m-0 h-dvh max-h-none w-full max-w-md overflow-y-auto border-0 bg-white p-0 text-ink shadow-2xl backdrop:bg-night/50 backdrop:backdrop-blur-sm">
  <div class="flex items-center justify-between border-b border-line px-6 py-4">
    <Img src={settings.logo.src} alt={settings.logo.alt} class="h-10 w-auto" />
    <button type="button" popovertarget="menu-c" popovertargetaction="hide" class="flex size-11 items-center justify-center rounded-full bg-fog" aria-label="Menü schließen">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 18 18 6M6 6l12 12"></path></svg>
    </button>
  </div>
  <nav aria-label="Hauptmenü" class="px-6 py-2">
    <AccordionNav
      items={settings.navigation}
      ui={{
        item: 'divide-y divide-line',
        top: 'py-4 text-xl font-semibold tracking-tight',
        col: 'font-semibold',
        link: 'text-sm text-muted hover:text-ink',
        note: 'ml-2 rounded-full bg-fog px-2 py-0.5 text-xs font-semibold text-leaf',
      }}
    />
  </nav>
  <div class="m-6 space-y-3 rounded-3xl bg-fog p-6">
    {
      headerBranches.map((b) => (
        <a href={telHref(b.phone)} class="flex items-center justify-between text-sm">
          <span class="text-muted">{b.name}</span>
          <span class="font-semibold">{b.phone}</span>
        </a>
      ))
    }
    <a href={settings.appointmentCta.href} class="btn-black mt-3 w-full">{settings.appointmentCta.label}</a>
  </div>
</div>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-[auto_1fr] gap-2 border-t border-line bg-white/95 p-3 backdrop-blur lg:hidden">
  <a href={settings.footer.phone.href} class="btn-ghost" aria-label={settings.footer.phone.label}>
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d={icons.phone}></path></svg>
  </a>
  <a href={settings.appointmentCta.href} class="btn-black">{settings.appointmentCta.label}</a>
</div>
