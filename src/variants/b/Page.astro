---
import './theme.css';
import type { VariantData } from '../shared';
import Shell from '../Shell.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Blocks from './Blocks.astro';
import VariantSwitcher from '../VariantSwitcher.astro';

interface Props {
  data: VariantData;
}

const { data } = Astro.props;
---

<Shell title={data.page.title}>
  <Header settings={data.settings} branches={data.branches} />
  <main id="main">
    <Blocks data={data} />
  </main>
  <Footer settings={data.settings} />
  <VariantSwitcher current="variant_b" />
</Shell>
